# Amazon Bedrock (Converse API). AWS access comes from the default chain
# (ECS task role in deployment; `aws sso login` / AWS_PROFILE locally). No key.
LLM_MODEL=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# Must match the REST API so its JWTs verify here.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# REST API base the agent's tools call for project/run/sample data.
NGS360_API_URL=http://localhost:3000/api/v1

# CORS: the frontend origin allowed to call this service.
CLIENT_ORIGIN=http://localhost:5173
